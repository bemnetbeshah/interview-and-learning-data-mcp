# SQLite database location for local or single-volume deployments.
INTERVIEW_PREP_DB_PATH=data/interview_prep.sqlite3

# Preferred production database. When set, this takes precedence over SQLite.
DATABASE_URL=

# FastMCP transport. Use stdio for local clients; use the HTTP transport
# supported by your installed MCP SDK for remote deployment.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Optional bearer mode for API clients that can pass Authorization directly.
MCP_BEARER_TOKEN=

# HTTP transports require OAuth or bearer auth by default. Set this only for
# local tunnel/testing environments that are not public.
MCP_ALLOW_UNAUTHENTICATED_HTTP=false

# Public OAuth/OIDC mode. Use these with a real identity provider for open
# signup. The token subject becomes the study owner_subject. Required grants
# can appear in scope, scp, permissions, roles, or role JWT claims.
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=interview-prep-mcp
OIDC_SUBJECT_CLAIM=sub
OIDC_REQUIRED_SCOPES=study:read study:write

# Public web pages used for app review, support, privacy, and terms.
PUBLIC_SERVICE_NAME=Interview Prep MCP
PUBLIC_CONTACT_EMAIL=support@example.com

# In-memory per-subject MCP tool-call limit per service instance.
RATE_LIMIT_PER_MINUTE=120

# Subject used for local unauthenticated runs and private single-subject auth.
MCP_DEFAULT_SUBJECT=bem

# Optional OAuth mode for ChatGPT Developer Mode. When set, the MCP exposes
# OAuth discovery, dynamic client registration, /authorize, /token, and /revoke.
# Use this secret in the browser approval form when connecting ChatGPT.
OAUTH_LOGIN_SECRET=
OAUTH_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Public HTTPS base URL for deployed metadata. Example:
# MCP_PUBLIC_BASE_URL=https://interview-prep.example.com
MCP_PUBLIC_BASE_URL=
